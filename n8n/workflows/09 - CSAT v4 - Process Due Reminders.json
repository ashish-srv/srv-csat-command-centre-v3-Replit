{
  "name": "9. CSAT v4 - Process Due Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "c3c83441-9833-4d9d-9377-a8023c54ef7c",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "37445847-70a8-41c3-92dd-44508d077b1e",
              "name": "CSAT_APP_URL",
              "value": "https://YOUR-REPLIT-APP.replit.app",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "99aa73fe-4049-4ed7-a2eb-b7eaf0bf8f91",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        288,
        0
      ],
      "notes": "Edit the three values here. They are not secrets. The webhook secret and Meta token live in credentials."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.CSAT_APP_URL }}/api/automation/process-due-reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "options": {
          "timeout": 30000
        },
        "specifyBody": "json",
        "jsonBody": "={{ { now: $now.toISO() } }}"
      },
      "id": "bc532d7d-1697-4f32-ae09-44b27164b8b2",
      "name": "Process Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        560,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "s7cNGrFKA4y4Hy88",
          "name": "CSAT Webhook Secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {},
      "id": "a62727bc-db23-4742-8524-1ac1cdfdbe38",
      "name": "Reminders Processed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        848,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Process Due Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Due Reminders": {
      "main": [
        [
          {
            "node": "Reminders Processed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": true
  }
}
