              "value": "ashish.kate@srvmedia.com",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "d4de139d-0115-486e-86c0-74d367c7c70a",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        288,
        0
      ],
      "notes": "Edit the three values here. They are not secrets. The webhook secret and Meta token live in credentials."
    },
    {
      "parameters": {
        "fromEmail": "directoroffice@srvmedia.com",
        "toEmail": "={{ $('Config').first().json.CSAT_HANDOFF_EMAIL }}",
        "subject": "={{ 'CSAT ' + ($json.body.eventType || 'handoff').replace(/_/g, ' ') + ': ' + ($json.body.project?.name || 'Unknown project') }}",
        "text": "={{ 'Event: ' + $json.body.eventType + '\\nGuardrail: ' + ($json.body.guardrail || 'n/a') + '\\nProject: ' + ($json.body.project?.name || '-') + '\\nClient POC: ' + ($json.body.poc?.name || '-') + ' (' + ($json.body.poc?.contactWhatsapp || 'no number') + ')\\nConversation state: ' + ($json.body.state || '-') + '\\n\\nWhat the client said:\\n' + ($json.body.clientText || '-') + '\\n\\nOpen the conversation:\\n' + ($json.body.resumeUrl || '-') + '\\n\\nThis message was NOT captured as feedback. A person needs to respond.' }}",
        "options": {}
      },
      "id": "2dcce632-fbd7-4e98-a23b-15ebf58f13f2",
      "name": "Notify Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
