        0
      ],
      "webhookId": "2174fab3-e54c-4aa1-b53a-c43c5b39bba1",
      "credentials": {
        "smtp": {
          "id": "NDpf2LfKVWN5zViN",
          "name": "SMTP (Ashish)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "pinData": {},
  "connections": {
