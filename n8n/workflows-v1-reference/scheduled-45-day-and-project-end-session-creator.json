{
  "name": "CSAT - Create Due 45-Day and Project-End Sessions",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 12 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CSAT_APP_URL + '/api/automation/create-due-sessions'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-csat-webhook-secret",
              "value": "={{$env.CSAT_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "now",
              "value": "={{$now.toISO()}}"
            }
          ]
        },
        "options": {}
      },
      "id": "create-due-sessions",
      "name": "Create Due Sessions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [560, 260]
    },
    {
      "parameters": {},
      "id": "note",
      "name": "Sessions Created",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 260]
    }
  ],
  "connections": {
    "Every 12 Hours": {
      "main": [[{ "node": "Create Due Sessions", "type": "main", "index": 0 }]]
    },
    "Create Due Sessions": {
      "main": [[{ "node": "Sessions Created", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
