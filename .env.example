# ---------------------------------------------------------------------
# Database migration
# ---------------------------------------------------------------------
# Replit provides DATABASE_URL when its SQL database is attached.
DATABASE_URL=

# PostgreSQL is the Replit default. DATABASE_URL is attached automatically;
# DATA_PROVIDER is shown explicitly for clarity.
DATA_PROVIDER=postgres
POSTGRES_POOL_MAX=10

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
PUBLIC_APP_URL=https://YOUR-REPLIT-APP.replit.app
PORT=3000
APP_LOGIN_PASSWORD=
APP_SESSION_SECRET=
ADMIN_PIN=

# ---------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------
N8N_WEBHOOK_SECRET=
N8N_FEEDBACK_STARTED_WEBHOOK=
N8N_FEEDBACK_RECEIVED_WEBHOOK=
N8N_MANAGER_ALERT_WEBHOOK=
N8N_NO_RESPONSE_WEBHOOK=
N8N_FEEDBACK_SESSION_CLOSED_WEBHOOK=
N8N_CYCLE_COMPLETED_WEBHOOK=
N8N_MANUAL_MESSAGE_WEBHOOK=
N8N_HUMAN_HANDOFF_WEBHOOK=

# ---------------------------------------------------------------------
# Gemini (optional; state-machine wording is used without it)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
