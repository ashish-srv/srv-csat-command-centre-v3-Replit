# ---------------------------------------------------------------------
# Database migration
# ---------------------------------------------------------------------
# Replit provides DATABASE_URL when its SQL database is attached.
DATABASE_URL=

# Temporary data-migration secrets. Add these only while copying the existing
# Supabase public-schema data, then delete both from Replit Secrets.
SOURCE_DATABASE_URL=
CONFIRM_REPLIT_DATA_REPLACE=

# PostgreSQL is the Replit default. DATABASE_URL is attached automatically;
# DATA_PROVIDER is shown explicitly for clarity.
DATA_PROVIDER=postgres
POSTGRES_POOL_MAX=10

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
PUBLIC_APP_URL=https://YOUR-REPLIT-APP.replit.app
PORT=3000
APP_LOGIN_PASSWORD=
APP_SESSION_SECRET=
# SESSION_SECRET is also supported and is the recommended name when reusing
# an existing Google-login configuration. Use at least 32 random characters.
SESSION_SECRET=

# Google Workspace login. GOOGLE_ALLOWED_DOMAINS is a comma-separated list
# without @, for example: srvmedia.com. The callback URL is derived from
# PUBLIC_APP_URL unless GOOGLE_REDIRECT_URI is explicitly set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_REDIRECT_URI=

# SMTP alerts when a client or project is created.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SRV CSAT Command Centre <notifications@srvmedia.com>
PROJECT_SETUP_ALERT_EMAILS=

# GOOGLE_SA_JSON_CONTENT is not required for user login. Service-account JSON
# is only needed when the application itself calls a Google API.
ADMIN_PIN=
# Set false to require project-end cycles to be started manually from Project Workspace.
# Automatic 30-day feedback continues normally.
AUTO_PROJECT_END_FEEDBACK=false

# ---------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------
N8N_WEBHOOK_SECRET=
N8N_FEEDBACK_STARTED_WEBHOOK=
N8N_QUICK_CHECKIN_WEBHOOK=
N8N_FEEDBACK_RECEIVED_WEBHOOK=
N8N_MANAGER_ALERT_WEBHOOK=
N8N_NO_RESPONSE_WEBHOOK=
N8N_FEEDBACK_SESSION_CLOSED_WEBHOOK=
N8N_CYCLE_COMPLETED_WEBHOOK=
N8N_MANUAL_MESSAGE_WEBHOOK=
N8N_HUMAN_HANDOFF_WEBHOOK=
N8N_WEBHOOK_TIMEOUT_MS=20000

# ---------------------------------------------------------------------
# Gemini (optional; state-machine wording is used without it)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
