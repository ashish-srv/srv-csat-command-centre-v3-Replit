run = "npm run dev"
entrypoint = "server.js"
modules = ["nodejs-24"]

[deployment]
build = "npm run build"
run = "npm start"

[gitHubImport]
requiredFiles = [".replit", "package.json"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8787
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
